    <child link="head_link1"/>
    <axis xyz="0. 1. 0."/>
    <origin xyz="0.0 0.0 0.033" rpy="0.0 -0.0 0.0"/>
    <!-- head_joint1: KRS-3302 ICS (assumed, see the block at the top).
