    <maxVel value="100.0"/>
    <minDepth value="0.0"/>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <!-- Mecanum: the rollers turn freely along one diagonal, so the contact
         grips (mu 1) only along the other (fdir1), expressed in base_link
         so it does not turn with the wheel (gz-sim's mecanum_drive.sdf).
         Isotropic friction (mu1 = mu2) made plain wheels that could not move
         sideways. No <material>: the CAD visual has its own colours. -->
    <collision name="front_right_wheel_link_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 xmlns:gz="http://gazebosim.org/schema" gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <kp>10000000</kp>
    <kd>1</kd>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <!-- Mecanum: the rollers turn freely along one diagonal, so the contact
         grips (mu 1) only along the other (fdir1), expressed in base_link
         so it does not turn with the wheel (gz-sim's mecanum_drive.sdf).
         Isotropic friction (mu1 = mu2) made plain wheels that could not move
         sideways. No <material>: the CAD visual has its own colours. -->
    <collision name="front_left_wheel_link_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 xmlns:gz="http://gazebosim.org/schema" gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <kp>10000000</kp>
    <kd>1</kd>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <!-- Mecanum: the rollers turn freely along one diagonal, so the contact
         grips (mu 1) only along the other (fdir1), expressed in base_link
         so it does not turn with the wheel (gz-sim's mecanum_drive.sdf).
         Isotropic friction (mu1 = mu2) made plain wheels that could not move
         sideways. No <material>: the CAD visual has its own colours. -->
    <collision name="rear_right_wheel_link_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 xmlns:gz="http://gazebosim.org/schema" gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <kp>10000000</kp>
    <kd>1</kd>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <!-- Mecanum: the rollers turn freely along one diagonal, so the contact
         grips (mu 1) only along the other (fdir1), expressed in base_link
         so it does not turn with the wheel (gz-sim's mecanum_drive.sdf).
         Isotropic friction (mu1 = mu2) made plain wheels that could not move
         sideways. No <material>: the CAD visual has its own colours. -->
    <collision name="rear_left_wheel_link_collision">
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 xmlns:gz="http://gazebosim.org/schema" gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
    <kp>10000000</kp>
    <kd>1</kd>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera name="camera">
        <!-- camera_model:=wide (default): 60 deg, depth to 10 m, the camera
             the samples were written against. camera_model:=d405: the real
             robot's RealSense D405: 87 deg wide, and depth only 0.07-0.5 m
             (its rated range; farther pixels have no depth, as on the robot,
             while the colour image still sees the whole room). -->
        <xacro:if value="${'$(arg camera_model)' == 'd405'}">
          <horizontal_fov>1.5184364492350666</horizontal_fov>
        </xacro:if>
        <xacro:unless value="${'$(arg camera_model)' == 'd405'}">
          <horizontal_fov>1.0471975511965976</horizontal_fov>
        </xacro:unless>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <!-- The colour image draws out to 40 m, so the far end of Room 13BC
             (26.8 m long) is in it; at 10 m the room beyond the desks came
             out blank. Depth keeps its own range below. -->
        <clip>
          <near>0.05</near>
          <far>40.0</far>
        </clip>
        <xacro:if value="${'$(arg camera_model)' == 'd405'}">
          <depth_camera>
            <clip>
              <near>0.07</near>
              <far>0.5</far>
            </clip>
          </depth_camera>
        </xacro:if>
        <xacro:unless value="${'$(arg camera_model)' == 'd405'}">
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
        </xacro:unless>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>/imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <imu>
        <orientation_reference_frame>
          <localization>CUSTOM</localization>
          <custom_rpy parent_frame="base_link">0 0 0</custom_rpy>
        </orientation_reference_frame>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- Rotor inertia and gear ratio per servo joint, in Drake's tags (see the
       block at the top). mechanicalReduction is the ROS transmission field for the same ratio.
       Not read by ros2_control (it reads only what is inside <ros2_control>) or by Gazebo. -->
  <transmission name="head_joint0_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_joint0">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_joint0_servo">
      <mechanicalReduction>262.92</mechanicalReduction>  <!-- KRS-3302 ICS datasheet -->
      <drake:gear_ratio value="262.92"/>
      <drake:rotor_inertia value="1e-8"/>  <!-- 不明; estimate, UNVERIFIED -->
    </actuator>
  </transmission>
  <transmission name="head_joint1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="head_joint1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="head_joint1_servo">
      <mechanicalReduction>262.92</mechanicalReduction>  <!-- KRS-3302 ICS datasheet -->
      <drake:gear_ratio value="262.92"/>
      <drake:rotor_inertia value="1e-8"/>  <!-- 不明; estimate, UNVERIFIED -->
    </actuator>
  </transmission>
  <transmission name="rarm_joint0_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rarm_joint0">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="rarm_joint0_servo">
      <mechanicalReduction>262.92</mechanicalReduction>  <!-- KRS-3302 ICS datasheet -->
      <drake:gear_ratio value="262.92"/>
      <drake:rotor_inertia value="1e-8"/>  <!-- 不明; estimate, UNVERIFIED -->
    </actuator>
  </transmission>
  <transmission name="rarm_joint1_trans">
