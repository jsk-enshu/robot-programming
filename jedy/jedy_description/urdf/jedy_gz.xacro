    <actuator name="rarm_joint2_servo">
      <mechanicalReduction>262.92</mechanicalReduction>  <!-- KRS-3302 ICS datasheet -->
      <drake:gear_ratio value="262.92"/>
      <drake:rotor_inertia value="1e-8"/>  <!-- 不明; estimate, UNVERIFIED -->
    </actuator>
  </transmission>
  <transmission name="rarm_joint3_trans">
    <type>transmission_interface/SimpleTransmission</type>
