    <axis xyz="0. 0. 1."/>
    <origin xyz="0.0 0.086 -0.0075" rpy="-3.141592653589793 -1.5707926535897931 1.5707926535897931"/>
    <!-- head_joint0: KRS-3302 ICS (assumed, see the block at the top).
         tau_f 0.13 N m, b 0.001 N m s/rad, armature 6.9e-4 kg m^2 (transmission below).
         source: estimate from the datasheet, UNVERIFIED; not measured on the robot. -->
    <dynamics damping="0.001" friction="0.13"/>
  </joint>
