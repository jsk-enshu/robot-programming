  ;; pre-defined pose methods


    (:reset-pose (&optional (limbs '(:rarm :larm :head)))

      "Predefined pose named reset-pose."

      (unless (listp limbs) (setq limbs (list limbs)))

      (dolist (limb limbs)

        (case limb

          (:rarm (send self :rarm :angle-vector #f(
 90
 -4
 -30
 -100
 -3
 -88
 -1
 0
)))

          (:larm (send self :larm :angle-vector #f(
 -90
 4
 30
 -100
 -88
 -6
 89
 -1
)))

          (:head (send self :head :angle-vector #f(
 0
 0
)))

          (t (format t "Unknown limb is passed: ~a~%" limb))
))
      (send self :angle-vector))

