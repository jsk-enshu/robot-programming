<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="RNG" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>jedy_bringup</name>
  <version>0.0.1</version>
  <description>
    ros2_control bring-up for the Jedy robot on real hardware: the
    &lt;ros2_control&gt; xacro that wraps jedy_description, the controller and
    Kondo bus configs, the launch files and the RViz layout.

    This is where the robot meets the driver, and the dependency runs one way:
    jedy depends on actuo, never the reverse. actuo is the actuator
    abstraction and must not know this robot's joint names, servo ids or link
    lengths. Everything
    here is per-robot, which is exactly why it lives here and not there.
  </description>
  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>jedy_odometry</exec_depend>
  <exec_depend>jedy_teleop</exec_depend>

  <!-- the robot -->
  <exec_depend>jedy_description</exec_depend>

  <!-- the driver (actuo's ROS 2 layer): the C++ ros2_control shim, the Python
       bus servicer that speaks Kondo ICS, the udev rules, the ARM-H7 symbol
       map, and the RViz servo/diagnostics panels. -->
  <exec_depend>actuo_hardware</exec_depend>
  <exec_depend>actuo_ros</exec_depend>
  <exec_depend>actuo_msgs</exec_depend>
  <exec_depend>actuo_rviz_plugins</exec_depend>

  <!-- stock ros2_control -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <!-- the mecanum base, named by jedy_fullbody_controllers.yaml. -->
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- jedy_gazebo.launch.py only -->
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- jedy_gazebo.launch.py world:=room13bc (the default): the exercise room -->
  <exec_depend>room13bc_description</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- topic_tools drop: thins /clock (jedy_gazebo.launch.py) -->
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
