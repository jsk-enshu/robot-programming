<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="RNG" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>jedy_bringup</name>
  <version>0.0.1</version>
  <description>
    ros2_control bring-up for the Jedy robot on real hardware: the
    &lt;ros2_control&gt; xacro that wraps jedy_description, the controller and
    Kondo bus configs, the launch files and the RViz layout. Also the
    simulator side (Gazebo system plugins, the simulated servo switch, motor
    sounds), wheel odometry (an estimate, kept out of actuo) and driving from
    a gamepad.

    This is where the robot meets the driver, and the dependency runs one way:
    jedy depends on actuo, never the reverse. actuo is the actuator
    abstraction and must not know this robot's joint names, servo ids or link
    lengths. Everything
    here is per-robot, which is exactly why it lives here and not there.
  </description>
  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- the Gazebo system plugins in src/ (servo OFF, mimic joints) -->
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <!-- the robot -->
  <exec_depend>jedy_description</exec_depend>

  <!-- the driver (actuo's ROS 2 layer): the C++ ros2_control shim, the Python
       bus servicer that speaks to the Kondo RCB-4mini, the udev rules, and the RViz servo/diagnostics panels. -->
  <exec_depend>actuo_hardware</exec_depend>
  <exec_depend>actuo_ros</exec_depend>
  <exec_depend>actuo_msgs</exec_depend>
  <exec_depend>actuo_rviz_plugins</exec_depend>

  <!-- stock ros2_control -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <!-- the mecanum base, named by jedy_fullbody_controllers.yaml. -->
  <exec_depend>mecanum_drive_controller</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- jedy_gazebo.launch.py only -->
  <exec_depend>ros_gz_sim</exec_depend>
  <!-- jedy_gazebo.launch.py world:=room13bc (the default): the exercise room -->
  <exec_depend>room13bc_description</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- topic_tools drop: thins /clock (jedy_gazebo.launch.py) -->
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- jedy_legacy_bridge and the 2025 exercise scripts and launch files -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <!-- track_box_to_cmd_vel_{0,1}.py: /camshift/track_box -->
  <exec_depend>opencv_apps</exec_depend>
  <!-- checkerboard_detector.py / .launch.py -->
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- launch/enshu.perspective -->
  <exec_depend>rqt_joint_trajectory_controller</exec_depend>
  <exec_depend>rqt_robot_steering</exec_depend>

  <!-- jedy_sim_servo, jedy_sim_sounds (motor sounds in Gazebo, sounds:=true) -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sound_play</exec_depend>
  <exec_depend>sound_play_msgs</exec_depend>
  <!-- jedy_wheel_odometry -->
  <exec_depend>nav_msgs</exec_depend>
  <!-- jedy_joy.launch.py: the gamepad driver -->
  <exec_depend>joy_linux</exec_depend>
  <!-- keyboard_teleop.launch.py and day 1's `ros2 run teleop_twist_keyboard`:
       otherwise only ros-jazzy-desktop brings it, which rosdep does not
       guarantee. -->
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- SLAM and Nav2 in Gazebo (docs/tips/slam.md): jedy_slam.launch.py,
       jedy_nav2.launch.py, map_saver_cli. nav2_bringup brings navigation2
       (AMCL, MPPI, ...), its RViz panels come with nav2_rviz_plugins. The
       LiDAR's odom TF is a tf2_msgs/TFMessage through ros_gz_bridge. -->
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
