Panels:
  - Class: rviz_common/Displays
    Name: Displays
  # Torque on/off, per joint, with the jump each would make shown before the
  # button. Needs the bus servicer running (`ros2 run actuo_ros actuo_bus_node`); with
  # backend:=mock it simply finds no server and says so.
  - Class: actuo_rviz_plugins/ServoPanel
    Name: Servo
    Namespace: /actuo_bus_servicer
    TrajectoryNamespace: /jedy/jedy_arm_controller/follow_joint_trajectory
  # Read-only diagnostics grouped by item path prefix (bus first, then servo):
  # this panel never clears or resets anything, it only shows what /diagnostics
  # currently says and whether updates have gone stale.
  - Class: actuo_rviz_plugins/DiagnosticsPanel
    Name: Diagnostics
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 10
      Cell Size: 0.5
      Color: 160; 160; 164
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /jedy/robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.3
      Pitch: 0.3
      Yaw: 0.8
