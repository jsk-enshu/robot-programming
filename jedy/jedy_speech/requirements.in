# scikit-robot: the SAME pin as jedy_skrobot (voice_command calls
# jedy_skrobot.connect(), whose interface subclasses skrobot's).
scikit-robot @ git+https://github.com/iory/scikit-robot.git@main

numpy
# Speech: Open JTalk (pyopenjtalk, MIT; dictionary BSD; voice "Mei" CC BY 3.0).
pyopenjtalk
# Recognition: Whisper on CTranslate2 (MIT), int8 on the CPU.
faster-whisper
# The speech bubbles are drawn into a texture.
pillow
# VOICEVOX CORE (MIT) for --engine voicevox. Only the library: the voice
# models and its ONNX Runtime are downloaded by each user with VOICEVOX's
# downloader, which asks them to accept the terms (setup_voicevox).
voicevox_core @ https://github.com/VOICEVOX/voicevox_core/releases/download/0.17.1/voicevox_core-0.17.1-cp310-abi3-manylinux_2_34_x86_64.whl

# shapely in this venv, not from the system. trimesh (via scikit-robot) imports
# it when present, and with --system-site-packages an apt python3-shapely
# (pulled in by e.g. ROS One jsk_recognition_utils) is found instead: built for
# NumPy 1, it prints "A module that was compiled using NumPy 1.x cannot be run
# in NumPy 2" on every start. PyPI shapely 2.x is built for NumPy 2.
shapely
