Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /jedy_fullbody/robot_description
    - Class: rviz_default_plugins/Marker
      Name: Speech bubbles
      Enabled: true
      Topic:
        Value: /speech/bubble
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point: {X: 0.35, Y: -0.15, Z: 0.42}
      Pitch: 0.12
      Yaw: 0.35
Window Geometry:
  Width: 1100
  Height: 700
