# Sim-servicer deps. rclpy/numpy/ament_index come from the ROS environment via
# --system-site-packages; these are the non-ROS pieces.
python-fcl
mujoco

# actuo: the shared memory the servicers write and the collision gate
# (filled in by CMakeLists.txt via actuo_ros' actuo_requirement()).
@ACTUO_REQUIREMENT@

# jedy_fake_servicer runs the real CollisionGate, which needs fcl, and builds
# the model with the SAME scikit-robot the collision meshes were made with.
scikit-robot @ git+https://github.com/iory/scikit-robot.git@main

# shapely in this venv, not from the system. trimesh (via scikit-robot) imports
# it when present, and with --system-site-packages an apt python3-shapely
# (pulled in by e.g. ROS One jsk_recognition_utils) is found instead: built for
# NumPy 1, it prints "A module that was compiled using NumPy 1.x cannot be run
# in NumPy 2" on every start. PyPI shapely 2.x is built for NumPy 2.
shapely
