<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="RNG" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>jedy_sim</name>
  <version>0.0.1</version>
  <description>
    Simulator side of Jedy: the Gazebo system plugins (servo OFF, mimic
    joints), the simulators' servo ON/OFF action (jedy_sim_servo), motor
    sounds (jedy_sim_sounds).
  </description>
  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <exec_depend>jedy_description</exec_depend>
  <exec_depend>actuo_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- jedy_sim_sounds: motor sounds in Gazebo (sounds:=true) -->
  <exec_depend>sound_play</exec_depend>
  <exec_depend>sound_play_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
