<?xml version="1.0"?>
<!-- Mechatrobot: Arduino UNO R4 WiFi, SG90 servo, HC-SR04 on a cradle on the
     servo horn. Meshes and the base_link -> motor_link -> link1 -> hc_sr04
     transforms come from the SolidWorks assembly (sw2robot export
     arduino_sg90_hcsr04_description); the link and joint names are the ones
     the rest of the package uses (joint1, range_sensor, led). -->
<robot name="robot">
  <!-- Arduino UNO R4 WiFi. Origin at a corner of the board, x along the long
       side (USB connector at x < 0), z up. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechatrobot_ros2/meshes/arduino_uno_r4_wifi_1.glb"/>
      </geometry>
    </visual>
  </link>

  <!-- SG90 servo body, lying next to the board with its shaft up. -->
  <link name="motor_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechatrobot_ros2/meshes/sg90_1.glb"/>
      </geometry>
    </visual>
  </link>

  <!-- Sensor cradle on the servo horn; turns with joint1. -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechatrobot_ros2/meshes/hcsr04_cradle_1.glb"/>
      </geometry>
    </visual>
  </link>

  <!-- HC-SR04 board. Its transducers face +z of this link. -->
  <link name="hc_sr04">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechatrobot_ros2/meshes/hc_sr04_1.glb"/>
      </geometry>
    </visual>
  </link>

  <!-- Frame of the /range messages: x points out of the transducers
       (sensor_msgs/Range measures along x). -->
  <link name="range_sensor"/>

  <!-- LED_BUILTIN ("L") on the board; led_controller.py draws a marker here. -->
  <link name="led"/>

  <joint name="base_to_motor" type="fixed">
    <parent link="base_link"/>
    <child link="motor_link"/>
    <origin xyz="0.09107008578 0.02666985587 0.009294932217" rpy="1.570796327 0 0"/>
  </joint>

  <!-- 0 rad is the servo's centre (Servo.write(90)); it turns +-90 deg.
       At 0 rad the sensor faces +x of base_link. -->
  <joint name="joint1" type="revolute">
    <parent link="motor_link"/>
    <child link="link1"/>
    <origin xyz="0.003909914222 0.01649506778 0" rpy="-1.570796327 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="3.0"/>
  </joint>

  <joint name="link1_to_hc_sr04" type="fixed">
    <parent link="link1"/>
    <child link="hc_sr04"/>
    <origin xyz="0.0004439344412 0.0001980352264 0.02417671319" rpy="0 -1.570796327 3.141592654"/>
  </joint>

  <!-- Front face of the transducers is 9.2 mm in front of the hc_sr04 origin. -->
  <joint name="hc_sr04_to_range_sensor" type="fixed">
    <parent link="hc_sr04"/>
    <child link="range_sensor"/>
    <origin xyz="0 0 0.0092" rpy="0 -1.570796327 0"/>
  </joint>

  <joint name="base_to_led" type="fixed">
    <parent link="base_link"/>
    <child link="led"/>
    <origin xyz="0.026 0.0435 0.003" rpy="0 0 0"/>
  </joint>

  <!-- ros2_control hardware interface -->
  <ros2_control name="MechatrobotHardwareSystem" type="system">
    <hardware>
      <plugin>mechatrobot_hardware/MechatrobotSystemHardware</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
